# Copy this file to .env and fill in your key.
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Social publishing (src/social.py) --------------------------------------
# Only needed to actually post. Generating copy needs just ANTHROPIC_API_KEY.
# Nothing here is loaded automatically — export these in your shell.

# Instagram (Graph API). IG_USER_ID is the Instagram Business account id.
IG_USER_ID=
IG_ACCESS_TOKEN=

# X (API v2). Must be a user-context OAuth 2.0 token — an app-only bearer
# token can read but cannot post.
X_ACCESS_TOKEN=

# LinkedIn. AUTHOR_URN looks like urn:li:person:XXXXXXXX
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
